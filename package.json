    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ package.json"
  },
  "author": "Yaki-Blake",
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
